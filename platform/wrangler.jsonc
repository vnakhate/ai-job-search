{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jobpilot",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [{ "name": "ACCOUNTS", "class_name": "AccountAgent" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AccountAgent"] }],
  "ai": { "binding": "AI" },
  "vars": {
    "APP_ORIGIN": "https://configure-your-domain.example",
    "OIDC_ISSUER": "https://configure-your-tenant.auth0.com/",
    "OIDC_CLIENT_ID": "",
    "OIDC_IOS_CLIENT_ID": "",
    "OIDC_AUDIENCE": "https://jobpilot-api",
    "STRIPE_PRICE_ID": "",
    "DEMO_MODE": "false",
  },
  "env": {
    "local": {
      "name": "jobpilot-local",
      "durable_objects": {
        "bindings": [{ "name": "ACCOUNTS", "class_name": "AccountAgent" }],
      },
      "vars": {
        "APP_ORIGIN": "http://localhost:8797",
        "DEMO_MODE": "true",
        "OIDC_ISSUER": "",
        "OIDC_CLIENT_ID": "",
        "OIDC_IOS_CLIENT_ID": "",
        "OIDC_AUDIENCE": "",
        "STRIPE_PRICE_ID": "",
      },
    },
  },
}
